{
  "name": "@ronbot/bot",
  "version": "2.1.0",
  "description": "A self-hosted Discord music bot that plays YouTube audio in voice channels.",
  "main": "./build/Bot.js",
  "scripts": {
    "start": "node ./build/Bot.js",
    "build": "tsc --build",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/Bot.ts\"",
    "deploy-commands": "node ./build/DeployCommands.js -deploy",
    "wipe-commands": "node ./build/DeployCommands.js -wipe",
    "deps-report": "node ./ci/discord-voice-gen-deps.js"
  },
  "author": "Ronnie Geraghty",
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.26.5",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "mongoose": "^9.7.4",
    "opusscript": "^0.1.1",
    "youtube-dl-exec": "^3.1.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "optionalDependencies": {
    "@snazzah/davey-linux-x64-gnu": "0.1.12",
    "@snazzah/davey-linux-x64-musl": "0.1.12"
  }
}

{
  "name": "ronbot",
  "version": "2.1.0",
  "private": true,
  "packageManager": "npm@11.10.0",
  "description": "Ron-bot monorepo: a self-hosted Discord music bot plus a companion audio-streaming client.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "start:bot": "npm run start --workspace @ronbot/bot",
    "start:native": "npm run build && node apps/bot/build/Bot.js",
    "deploy-commands": "npm run deploy-commands --workspace @ronbot/bot",
    "wipe-commands": "npm run wipe-commands --workspace @ronbot/bot"
  },
  "author": "Ronnie Geraghty",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "turbo": "^2.5.0",
    "typescript-eslint": "^8.16.0"
  },
  "overrides": {
    "discord.js": {
      "undici": "6.27.0"
    }
  }
}
